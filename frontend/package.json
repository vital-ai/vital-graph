{
  "name": "flowbite-react-template-vite",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:only": "tsc -b && vite build",
    "build": "npm run build:only && npm run deploy:local",
    "deploy:local": "rm -rf ../vitalgraph/api/frontend/dist && mkdir -p ../vitalgraph/api/frontend && cp -r dist ../vitalgraph/api/frontend/",
    "lint": "eslint .",
    "preview": "vite preview",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@types/leaflet": "^1.9.22",
    "@vis.gl/react-google-maps": "^1.10.0",
    "@vital-ai/vital-kg-model-ts": "^0.1.0",
    "@vital-ai/vital-model-utils": "^0.1.7",
    "@vital-ai/vitalgraph-client": "file:../vitalgraph-client-ts",
    "apexcharts": "^7.1.0",
    "cytoscape": "^3.34.3",
    "cytoscape-cola": "^2.5.1",
    "cytoscape-context-menus": "^4.2.1",
    "cytoscape-cose-bilkent": "^4.1.0",
    "cytoscape-dagre": "^4.0.1",
    "cytoscape-elk": "^2.3.0",
    "cytoscape-fcose": "^2.2.0",
    "flowbite-react": "^0.12.17",
    "leaflet": "^1.9.4",
    "react": "^19.2.8",
    "react-apexcharts": "^2.1.1",
    "react-dom": "^19.2.8",
    "react-icons": "^5.7.0",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.6.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.24.0",
    "@tailwindcss/vite": "^4.1.4",
    "@types/cytoscape": "^3.31.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.24.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^15.15.0",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "tailwindcss": "^4.1.4",
    "typescript": "~5.7.3",
    "typescript-eslint": "^8.30.1",
    "vite": "^6.2.6",
    "vitest": "^4.1.10"
  }
}
