/*vg:plan 1
size k1 50 a un
method m1 hash a un
*/ SELECT * FROM q9 a
   JOIN ((SELECT b.s AS k FROM q9 b JOIN q9 c ON c.s = b.s WHERE b.p = 2 AND c.p = 3)
         UNION ALL
         (SELECT d.s AS k FROM q9 d JOIN q9 e ON e.s = d.s WHERE d.p = 4 AND e.p = 5)) un ON un.k = a.s
   WHERE a.p = 1;
