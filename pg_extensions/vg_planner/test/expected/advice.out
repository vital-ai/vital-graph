size k1 77 a g
method m1 hash a g
*/ SELECT * FROM q9 a
   JOIN (SELECT b.s, max(b.o) AS m FROM q9 b WHERE b.p = 2 GROUP BY b.s) g ON g.s = a.s
   WHERE a.p = 1;
