                     Recheck Cond: (p = 4)
                     ->  Bitmap Index Scan on q9_ps
                           Index Cond: (p = 4)
               ->  Hash
                     ->  Bitmap Heap Scan on q9 e
                           Recheck Cond: (p = 5)
                           ->  Bitmap Index Scan on q9_ps
                                 Index Cond: (p = 5)
   ->  Hash
