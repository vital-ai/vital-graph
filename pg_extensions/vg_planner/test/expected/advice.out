-- A size over an OUTER join: the join relation's relids include the outer
-- join's own index (PG 16+); the size still matches on its base relations.
CREATE TABLE q4 (s int, p int, o int);
INSERT INTO q4 SELECT g % 997, g % 13, (g * 7) % 1013 FROM generate_series(1, 24000) g;
ANALYZE q4;
EXPLAIN (COSTS ON)
/*vg:plan 1
size s1 77 a b
*/ SELECT * FROM q4 a LEFT JOIN q4 b ON b.s = a.s AND b.p = 2 WHERE a.p = 1;
                              QUERY PLAN                              
----------------------------------------------------------------------
 Hash Left Join  (cost=453.09..979.64 rows=77 width=24)
   Hash Cond: (a.s = b.s)
   ->  Seq Scan on q4 a  (cost=0.00..430.00 rows=1847 width=12)
         Filter: (p = 1)
   ->  Hash  (cost=430.00..430.00 rows=1847 width=12)
         ->  Seq Scan on q4 b  (cost=0.00..430.00 rows=1847 width=12)
               Filter: (p = 2)
(7 rows)

SELECT vg_planner_last_report();
        vg_planner_last_report         
---------------------------------------
 size s1: 77 applied (PostgreSQL 3422)
(1 row)

DROP TABLE q4;
-- Corrections travel between join problems: under join_collapse_limit = 1 a
-- written JOIN tree is planned as nested problems, and a corrected join
-- relation from one is an input to the next. Its estimate must not be
-- corrected a second time there.
CREATE TABLE q5 (s int, p int, o int);
INSERT INTO q5 SELECT g % 997, g % 13, (g * 7) % 1013 FROM generate_series(1, 24000) g;
ANALYZE q5;
SET join_collapse_limit = 1;
EXPLAIN (COSTS ON)
/*vg:plan 1
bgp b0 steps(a b) rows(b:340)
*/ SELECT * FROM (q5 a JOIN q5 b ON b.s = a.s AND b.p = 2) JOIN q5 c ON c.s = b.s AND c.p = 3 WHERE a.p = 1;
                                 QUERY PLAN                                 
----------------------------------------------------------------------------
 Hash Join  (cost=906.16..1450.49 rows=630 width=36)
   Hash Cond: (b.s = c.s)
   ->  Hash Join  (cost=453.09..979.64 rows=340 width=24)
         Hash Cond: (a.s = b.s)
         ->  Seq Scan on q5 a  (cost=0.00..430.00 rows=1847 width=12)
               Filter: (p = 1)
         ->  Hash  (cost=430.00..430.00 rows=1847 width=12)
               ->  Seq Scan on q5 b  (cost=0.00..430.00 rows=1847 width=12)
                     Filter: (p = 2)
   ->  Hash  (cost=430.00..430.00 rows=1846 width=12)
         ->  Seq Scan on q5 c  (cost=0.00..430.00 rows=1846 width=12)
               Filter: (p = 3)
(12 rows)

RESET join_collapse_limit;
DROP TABLE q5;
-- A one-alias size: the base relation's scan estimate, which the joins above
-- are built on.
CREATE TABLE q6 (s int, p int, o int);
INSERT INTO q6 SELECT g % 997, g % 13, (g * 7) % 1013 FROM generate_series(1, 24000) g;
CREATE INDEX q6_po ON q6 (p, o);
ANALYZE q6;
EXPLAIN (COSTS ON) SELECT * FROM q6 a WHERE a.p = 1 AND a.o = 5;
                             QUERY PLAN                             
--------------------------------------------------------------------
 Bitmap Heap Scan on q6 a  (cost=4.31..11.59 rows=2 width=12)
   Recheck Cond: ((p = 1) AND (o = 5))
   ->  Bitmap Index Scan on q6_po  (cost=0.00..4.31 rows=2 width=0)
         Index Cond: ((p = 1) AND (o = 5))
(4 rows)

EXPLAIN (COSTS ON)
/*vg:plan 1
size s1 1159 a
*/ SELECT * FROM q6 a WHERE a.p = 1 AND a.o = 5;
                             QUERY PLAN                             
--------------------------------------------------------------------
 Bitmap Heap Scan on q6 a  (cost=4.31..4226.42 rows=1159 width=12)
   Recheck Cond: ((p = 1) AND (o = 5))
   ->  Bitmap Index Scan on q6_po  (cost=0.00..4.31 rows=2 width=0)
         Index Cond: ((p = 1) AND (o = 5))
(4 rows)

