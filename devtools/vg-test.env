# The vg-test stack, named explicitly rather than left to a default.
#
#   set -a; . devtools/vg-test.env; set +a
#   python -m pytest tests/...
#
# WHY THIS FILE EXISTS. Every selector below already DEFAULTS to the test stack,
# so nothing here changes what a clean run does. What it changes is that the
# choice stops depending on two things that are not choices:
#
#   1. Import order. `tests/api/conftest.py` reads LOCAL_CLIENT_SERVER_URL and
#      falls back to :8002. `.env` sets that same variable to :8001 — the DEV
#      server, on the HOST cluster. Any `load_dotenv()` reached before that
#      conftest is imported moves the whole API suite onto the dev stack, which
#      is up and answers 200, so it passes. Today the ordering happens to be
#      safe. That is luck, not design, and it is issues/055 in the API suite.
#
#   2. Which script you ran. `devtools/target.py` resolves the database and
#      sidecar for the suites, but an ad-hoc `psql -p 5432` or a script with its
#      own hardcoded parameters bypasses it entirely — which is how a
#      measurement gets taken against the host cluster and reported as the test
#      stack's.
#
# An exported variable beats `.env`: python-dotenv does not override values
# already in the environment. So sourcing this makes the target explicit and
# immune to both.
#
# `tests/unit/test_vg_test_env_names_every_selector.py` fails if a suite starts
# reading a selector this file does not set.

# --- database: the docker test stack, NOT the host cluster on 5432 ---
VG_TEST_PG_HOST=localhost
VG_TEST_PG_PORT=5433
VG_TEST_PG_DATABASE=sparql_sql_graph
VG_TEST_PG_USER=postgres
VG_TEST_PG_PASSWORD=testpass

# --- Jena sidecar: the test container, NOT the dev one on 7070 ---
# It is a STATELESS COMPILER, so the wrong instance returns a plausible AST
# rather than an error, and version skew lands as a query-shape mystery.
VG_TEST_SIDECAR_URL=http://localhost:7071

# --- API: vitalgraph-test-app, NOT vitalgraph-app on 8001 ---
# Two names because the suites disagree: tests/api reads the client variable,
# tests/performance reads VG_TEST_API_URL. Both are set so neither can drift
# onto the dev server on its own.
LOCAL_CLIENT_SERVER_URL=http://localhost:8002
VG_TEST_API_URL=http://localhost:8002
VG_TEST_API_USER=admin
VG_TEST_API_PASSWORD=admin
